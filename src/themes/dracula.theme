# Rich-rs theme generated from Pygments 'dracula' theme
# Use with Theme::from_file() or Theme::from_reader()

[styles]
json.bool_false = italic rgb(255,121,198)
json.bool_true = italic rgb(255,121,198)
json.brace = rgb(248,248,242)
json.key = rgb(255,121,198)
json.null = italic rgb(255,121,198)
json.number = rgb(255,184,108)
json.str = rgb(189,147,249)
repr.attrib_equal = rgb(255,121,198)
repr.attrib_name = rgb(80,250,123)
repr.bool_false = italic rgb(255,121,198)
repr.bool_true = italic rgb(255,121,198)
repr.brace = rgb(248,248,242)
repr.call = rgb(80,250,123)
repr.comma = rgb(248,248,242)
repr.error = rgb(248,248,242)
repr.indent = rgb(98,114,164)
repr.none = italic rgb(255,121,198)
repr.number = rgb(255,184,108)
repr.number_complex = rgb(255,184,108)
repr.path = italic rgb(139,233,253)
repr.str = rgb(189,147,249)
repr.tag_end = rgb(248,248,242)
repr.tag_name = rgb(80,250,123)
repr.tag_start = rgb(248,248,242)
repr.url = italic rgb(139,233,253)
